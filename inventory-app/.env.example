# ===== 共通 =====
# アプリの共通PINコード（本番では必ず変更すること。未設定時の開発用デフォルトは 1234）
APP_PIN=1234

# データの保存先: local（リポジトリ内のExcel・開発用） / graph（Teams上のExcel・本番用）
STORE_MODE=local

# ===== STORE_MODE=graph のとき必須（docs/inventory-app-Azure設定手順.md 参照）=====
# Azure ADテナントID / アプリ登録のクライアントID・シークレット
#AZURE_TENANT_ID=
#AZURE_CLIENT_ID=
#AZURE_CLIENT_SECRET=
# Teams（SharePoint）上のExcelファイルの場所
#GRAPH_DRIVE_ID=
#GRAPH_ITEM_ID=

# ===== STORE_MODE=local の任意設定 =====
# ローカルExcelの作業コピーの場所（既定: data/inventory.local.xlsx）
#LOCAL_XLSX_PATH=
